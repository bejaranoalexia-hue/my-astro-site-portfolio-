---
import PageLayout from '~/layouts/PageLayout.astro';
import Button from '~/components/Button.astro';
import siteConfig from '~/config/site';
import { graph, personSchema, breadcrumbSchema } from '~/lib/jsonld';

const linkedIn = siteConfig.social.find((s) => s.icon === 'linkedin');

const jsonLd = graph([
  personSchema(siteConfig),
  breadcrumbSchema([
    { name: 'Home', url: `${siteConfig.url}/` },
    { name: 'Contact', url: `${siteConfig.url}/contact/` },
  ]),
]);
---

<PageLayout
  title="Contact"
  heading="Tell me where leads stall today."
  eyebrow="Contact"
  intro="Reach out on LinkedIn and I'll map the stack that closes the gap."
  description={`Get in touch with ${siteConfig.author} about AI, marketing operations, CRM automation, or search.`}
  crumbs={[{ label: 'Contact' }]}
  jsonLd={jsonLd}
>
  <section class="wrap sec" style="padding-top:0" aria-labelledby="contact-h">
    <div class="rev" style="max-width:42ch">
      <h2 class="sr-only" id="contact-h">LinkedIn</h2>
      {
        linkedIn && (
          <Button href={linkedIn.href} variant="ink" icon="linkedin">{linkedIn.label}</Button>
        )
      }
    </div>
  </section>
</PageLayout>
