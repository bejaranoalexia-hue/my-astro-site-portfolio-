---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Contact" currentPage="contact">
	<section class="section section-hero" aria-labelledby="contact-heading">
		<div class="container has-text-centered">
			<p class="tag is-primary is-medium mb-5">Contact</p>
			<h1 id="contact-heading" class="title is-1">
				Let's make something great
			</h1>
			<p class="subtitle is-4 mt-4 u-constrained-sm">
				New project, partnership, or just want to say hello?
				We read every message.
			</p>
		</div>
	</section>

	<section class="section has-bg-elevated" aria-label="Contact form">
		<div class="container u-constrained-md">
			<div class="box is-spacious">
				<div id="hubspot-form" class="hubspot-form"></div>
			</div>

			<div class="has-text-centered mt-6">
				<p class="is-size-5 has-text-weight-semibold has-text-white mb-4">
					Prefer to reach out directly?
				</p>
				<p class="mb-2">
					<a href="mailto:bejaranoalexia@gmail.com" class="has-text-primary">bejaranoalexia@gmail.com</a>
				</p>
			</div>
		</div>
	</section>
</Layout>

<script is:inline>
	const HUBSPOT_PORTAL_ID = "14531724";
	const HUBSPOT_FORM_ID = "dfac6549-4817-4bb2-b710-cfa672c5e999";
	const HUBSPOT_REGION = "na1";

	function mountHubspotForm() {
		const target = document.getElementById("hubspot-form");
		if (!target) return;
		target.innerHTML = "";

		const create = () => {
			if (!window.hbspt?.forms) return;
			window.hbspt.forms.create({
				portalId: HUBSPOT_PORTAL_ID,
				formId: HUBSPOT_FORM_ID,
				region: HUBSPOT_REGION,
				target: "#hubspot-form",
				onFormReady() {
					const frame = document.querySelector("#hubspot-form .hs-form-frame");
					if (frame) frame.style.height = "auto";
				},
			});
		};

		if (window.hbspt?.forms) {
			create();
			return;
		}

		const existing = document.querySelector('script[data-hubspot-forms="v2"]');
		if (existing) {
			existing.addEventListener("load", create, { once: true });
			return;
		}

		const script = document.createElement("script");
		script.src = "https://js.hsforms.net/forms/v2.js";
		script.charset = "utf-8";
		script.async = true;
		script.dataset.hubspotForms = "v2";
		script.addEventListener("load", create, { once: true });
		document.body.appendChild(script);
	}

	document.addEventListener("astro:page-load", mountHubspotForm);
	mountHubspotForm();
</script>
